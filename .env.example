# ---------------------------------------------------------------------------
# UCI environment configuration — example only. Copy to `.env` and fill real
# values locally; never commit secrets (docs/14 §24, §25).
# ---------------------------------------------------------------------------

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# ---- Public site ---------------------------------------------------------
# Canonical public origin consumed by Astro (astro.config.mjs). Required in
# production; the placeholder below only exists so local builds don't crash.
SITE_URL=https://uci.example.org

# ---- Database (Phase 1) --------------------------------------------------
# Full connection string for the local Node API (runs on the host, outside
# Docker). Port 5432 is the default host-mapped port in docker-compose.yml.
DATABASE_URL=postgres://uci:uci2026@localhost:5432/uci_db

# ---- Docker Compose (postgres service) -----------------------------------
POSTGRES_USER=uci
POSTGRES_PASSWORD=uci2026
POSTGRES_DB=uci_db
# Host port for the postgres container (default 5432). Set 5435 (or another
# free port) locally if 5432 is already in use on your machine.
POSTGRES_PORT=5432

# ---- Authentication (Phase 2, docs/11 §5–6) ------------------------------
# Session lifetimes in seconds (docs/11 §6.3). The absolute TTL is fixed at
# login and never extended; the idle TTL slides forward on activity.
# Defaults when unset: 604800 (7 days) and 43200 (12 hours).
SESSION_ABSOLUTE_TTL=604800
SESSION_IDLE_TTL=43200

# Initial admin user — consumed ONLY by `pnpm db:seed`. Leave both unset to
# skip admin bootstrapping. Never commit real credentials (docs/11 §26).
ADMIN_EMAIL=
ADMIN_PASSWORD=
