# ---------------------------------------------------------------------------
# UCI environment configuration — example only. Copy to `.env` and fill real
# values locally; never commit secrets (docs/14 §24, §25).
# ---------------------------------------------------------------------------

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Reverse proxy(ies) trusted to set X-Forwarded-For (Fastify `trustProxy`).
# Defaults to `loopback` for the same-origin Astro proxy. Use an IP/CIDR list
# when the proxy connects from another host; never use `true` on a public API.
TRUST_PROXY=loopback

# ---- Public site (Astro SSR) --------------------------------------------
# Canonical public origin consumed by Astro (astro.config.mjs) and the API's
# canonical/sitemap URLs. REQUIRED in production: the placeholder below only
# exists so local builds don't crash, and the API logs a startup warning while
# it is still in use.
SITE_URL=https://uci.example.org

# Church-local IANA timezone used to interpret offset-less editorial and
# schedule datetimes and exposed by `GET /api/v1/settings/public`. Invalid
# identifiers fail fast at startup. Default: America/Bogota.
APP_TIMEZONE=America/Bogota

# Base URL of the public CMS API consumed by the Astro server at request time.
# The Astro build never calls the API: fetching happens per request (Phase 9A).
# Keep the host-only origin (the client appends `/api/v1/...`).
API_BASE_URL=http://127.0.0.1:8787

# Timeout, in milliseconds, for each public API request. When the API is down
# the homepage degrades to honest empty states instead of failing the render.
API_TIMEOUT_MS=5000

# ---- Database (Phase 1) --------------------------------------------------
# Full connection string for the local Node API (runs on the host, outside
# Docker). Port 5432 is the default host-mapped port in docker-compose.yml.
DATABASE_URL=postgres://uci:uci2026@localhost:5432/uci_db

# ---- Docker Compose (postgres service) -----------------------------------
POSTGRES_USER=uci
POSTGRES_PASSWORD=uci2026
POSTGRES_DB=uci_db
# Host port for the postgres container (default 5432). Set 5435 (or another
# free port) locally if 5432 is already in use on your machine.
POSTGRES_PORT=5432

# ---- Media storage (Phase 4, docs/12 §7) ---------------------------------
# Filesystem root for uploaded binaries (relative to the server cwd, or an
# absolute path). Never commit uploaded files; `media/` is gitignored.
MEDIA_ROOT=./media
# Public URL prefix for served media. Use an absolute URL (CDN/media host) to
# disable the local `@fastify/static` mount and emit CDN URLs instead.
MEDIA_PUBLIC_BASE=/media
# Hard upload ceiling in bytes (default 10 MB).
MEDIA_MAX_UPLOAD_BYTES=10485760
# Orphan media cleanup age in days. `0` (default) disables the scheduled
# sweep; a positive value deletes assets with no MediaReference older than N
# days. The admin endpoint still allows explicit dry-run/cleanup.
MEDIA_ORPHAN_CLEANUP_DAYS=0

# ---- Authentication (Phase 2, docs/11 §5–6) ------------------------------
# Session lifetimes in seconds (docs/11 §6.3). The absolute TTL is fixed at
# login and never extended; the idle TTL slides forward on activity.
# Defaults when unset: 604800 (7 days) and 43200 (12 hours).
SESSION_ABSOLUTE_TTL=604800
SESSION_IDLE_TTL=43200

# ---- Scheduled publication (Phase 12B, docs/15 §18.6) --------------------
# Milliseconds between scheduled-content sweeps in the API process. One minute
# by default. The scheduler never runs in tests or during the Astro build; it
# starts only when the API process calls `listen`.
SCHEDULER_INTERVAL_MS=60000

# ---- Email notifications (Phase 11A, docs/15 §17.3) ----------------------
# Delivery foundation for contact-form notifications. `log` records a
# simulated, redacted send (development); `none` disables delivery. Defaults
# to `log` outside production and `none` in production. A real SMTP/API
# provider is configured in Phase 13 — never commit credentials here.
EMAIL_PROVIDER=log
# Admin inbox that receives contact-form notifications. Unset disables the
# notification entirely (the submission is still stored).
CONTACT_NOTIFY_TO=

# Initial admin user — consumed ONLY by `pnpm db:seed`. Leave both unset to
# skip admin bootstrapping. Never commit real credentials (docs/11 §26).
ADMIN_EMAIL=admin@uci.local
ADMIN_PASSWORD=AdminUCI2026*
