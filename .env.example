# ---------------------------------------------------------------------------
# UCI environment configuration — example only. Copy to `.env` and fill real
# values locally; never commit secrets (docs/14 §24, §25).
# ---------------------------------------------------------------------------

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# ---- Public site ---------------------------------------------------------
# Canonical public origin consumed by Astro (astro.config.mjs). Required in
# production; the placeholder below only exists so local builds don't crash.
SITE_URL=https://uci.example.org

# ---- Database (Phase 1 — not yet connected, docs/07 §58) -----------------
# Full connection string for the Node API. Keep the placeholder until the
# persistence layer lands.
DATABASE_URL=postgres://uci:CHANGE_ME@localhost:5432/uci

# ---- Docker Compose (postgres service) -----------------------------------
POSTGRES_USER=uci
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=uci
