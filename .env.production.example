# ---------------------------------------------------------------------------
# UCI production environment — EXAMPLE ONLY (docs/14 §23–§26, §86–§88).
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   # replace every CHANGE_ME / example.org value with a real one
#
# `.env.production` is gitignored. Never commit it and never put secrets in
# the repository. Compose must be invoked with `--env-file .env.production`
# so build-time values (SITE_URL) and interpolation resolve from this file.
# ---------------------------------------------------------------------------

# ---- Public identity / TLS ------------------------------------------------
# Canonical public hostname only (no scheme). Caddy obtains TLS for it.
DOMAIN=uci.example.org
# Must be https + DOMAIN. Baked into the Astro build (canonical, OG, sitemap).
SITE_URL=https://uci.example.org
# Optional ACME account email for certificate-expiry notices.
ACME_EMAIL=ops@example.org

# ---- Runtime --------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# Internal API origin used by the Astro server at request time. Must be the
# compose service, not the public origin (avoids a TLS hairpin).
API_BASE_URL=http://api:8787
API_TIMEOUT_MS=5000

# Proxy addresses trusted for X-Forwarded-For/Proto. Caddy is the only ingress
# and lives on a Docker private network, so trust the private ranges. Never
# use `true` on a publicly reachable API.
TRUST_PROXY=172.16.0.0/12

# ---- Database -------------------------------------------------------------
# Reachable only from the compose network: host is `postgres`, port 5432.
# DATABASE_URL, POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB must agree.
# Generate a URL-safe password, e.g.: openssl rand -hex 32
DATABASE_URL=postgres://uci:CHANGE_ME_DB_PASSWORD@postgres:5432/uci_db
POSTGRES_USER=uci
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=uci_db

# ---- Sessions (docs/11 §6.3) ----------------------------------------------
# Seconds. Absolute lifetime is fixed at login; the idle timeout slides.
SESSION_ABSOLUTE_TTL=604800
SESSION_IDLE_TTL=43200

# ---- Media storage (docs/12 §7, docs/14 §11) ------------------------------
# Container path backed by the `media_data` volume.
MEDIA_ROOT=/app/media
MEDIA_PUBLIC_BASE=/media
MEDIA_MAX_UPLOAD_BYTES=10485760

# ---- Email notifications (docs/14 §76) ------------------------------------
# `none` disables delivery; `log` only writes a redacted simulation. A real
# provider is not part of this deployment yet.
EMAIL_PROVIDER=none
CONTACT_NOTIFY_TO=

# ---- Initial admin (seed only, docs/11 §26) -------------------------------
# Consumed ONLY by `pnpm db:seed` inside the `migrate` tooling image. Leave
# unset after seeding if you prefer; never commit the real password.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---- Scheduled publication (docs/14 §77–§79) ------------------------------
SCHEDULER_INTERVAL_MS=60000
