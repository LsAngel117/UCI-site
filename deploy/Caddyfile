# ---------------------------------------------------------------------------
# UCI production edge (Phase 13, docs/14 §13–§19, §62).
#
# DOMAIN is injected from `.env.production` (compose `env_file`). Caddy obtains
# and renews TLS certificates automatically once DNS points at this server.
#
# Routing:
#   /api/*     → api:8787   (versioned API, never rewritten)
#   /panel*    → api:8787   (admin SPA, noindex)
#   /media/*   → files from the shared media_data volume (read-only mount)
#   everything → web:4321   (Astro SSR public site)
#
# Security headers are a defence-in-depth complement to the ones the app emits
# (`src/shared/security.ts`). CSP is intentionally NOT set here: the app's CSP
# carries a per-request nonce that Caddy cannot reproduce.
# ---------------------------------------------------------------------------

# Optional: uncomment and set ACME_EMAIL in `.env.production` to receive
# certificate-expiry notices. Auto-HTTPS works without it.
# {
# 	email {$ACME_EMAIL}
# }

{$DOMAIN} {
	encode zstd gzip

	# Public JSON API (versioned contract, docs/14 §18).
	@api path /api/*
	handle @api {
		reverse_proxy api:8787
	}

	# Admin SPA shell and assets. Keep it out of search indexes.
	handle /panel* {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy api:8787
	}

	# CMS media. Uploaded keys are content-addressed, so derivatives are
	# immutable (docs/12 §45–§46, docs/14 §69). Caddy serves the same named
	# volume the API writes to; the app's `/media` static mount stays as a
	# fallback for non-Caddy deployments.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: the Astro SSR site.
	handle {
		reverse_proxy web:4321
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

# Optional canonical-host redirect. Uncomment only after `www.<domain>` also
# resolves to this server; Caddy cannot issue a certificate for a hostname
# that does not resolve (docs/14 §62).
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
