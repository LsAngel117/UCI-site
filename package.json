{
  "name": "purple-giant",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm build:admin",
    "build:server": "node scripts/build-server.mjs",
    "build:prod": "pnpm build && pnpm build:server",
    "preview": "astro preview",
    "start:web": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "check": "astro check",
    "check:server": "tsc --noEmit -p tsconfig.server.json",
    "check:admin": "tsc --noEmit -p tsconfig.admin.json",
    "check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "pnpm check && pnpm check:server && pnpm check:admin && pnpm check:e2e",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "playwright:install": "playwright install chromium",
    "dev:server": "tsx watch src/server/server.ts",
    "start:server": "tsx src/server/server.ts",
    "dev:admin": "vite --config src/admin/vite.config.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "build:admin": "vite build --config src/admin/vite.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.11",
    "@astrojs/sitemap": "^3.7.4",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.10",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@lucide/astro": "^1.53.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "astro": "^7.3.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
