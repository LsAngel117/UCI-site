{
  "name": "purple-giant",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:server": "tsc --noEmit -p tsconfig.server.json",
    "check:admin": "tsc --noEmit -p tsconfig.admin.json",
    "typecheck": "pnpm check && pnpm check:server && pnpm check:admin",
    "dev:server": "tsx watch src/server/server.ts",
    "start:server": "tsx src/server/server.ts",
    "dev:admin": "vite --config src/admin/vite.config.ts",
    "build:admin": "vite build --config src/admin/vite.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@lucide/astro": "^1.53.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "astro": "^7.3.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}