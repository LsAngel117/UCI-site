{
  "name": "purple-giant",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:server": "tsc --noEmit -p tsconfig.server.json",
    "check:admin": "tsc --noEmit -p tsconfig.admin.json",
    "typecheck": "pnpm check && pnpm check:server && pnpm check:admin",
    "dev:server": "tsx watch src/server/server.ts",
    "start:server": "tsx src/server/server.ts",
    "dev:admin": "vite --config src/admin/vite.config.ts",
    "build:admin": "vite build --config src/admin/vite.config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@lucide/astro": "^1.53.0",
    "astro": "^7.3.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}