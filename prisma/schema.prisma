// ---------------------------------------------------------------------------
// Iglesia UCI — Prisma schema (Phase 1: Shared Core & Database foundation).
//
// Location decision: the canonical schema lives at `prisma/schema.prisma`
// (repo root), not under `src/db/`. This is Prisma's convention and keeps the
// schema next to `prisma/migrations/` so `prisma migrate`/`generate`/`studio`
// work with zero config. `src/db/` (Phase 0 skeleton) remains for future
// domain notes and seed data (docs/02 §33, docs/14 §35).
//
// Conventions (docs/02 §31–33, docs/08 §34–36):
//   - IDs: `String @id @default(uuid())` — UUIDs are generated by the API,
//     never by clients (docs/08 §34).
//   - Naming: DB objects are snake_case; Prisma fields are camelCase mapped
//     via `@map` / `@@map`. Every field carries an explicit `@map` so the DB
//     schema never depends on Prisma's field casing.
//   - Timestamps: every table has `created_at` (+ `updated_at` unless the
//     table is append-only). Content tables add `published_at` /
//     `unpublished_at`; auditable tables add `created_by` / `updated_by`.
//   - Content lifecycle: `ContentStatus` here MUST stay in sync with
//     `@shared/types.ts` (the single source of truth for domain contracts).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Editorial lifecycle for CMS-managed content. Mirrors `ContentStatus` in
/// `src/shared/types.ts` (docs/08 §22). Values are lowercase to match the
/// shared string-literal union; keep them in sync.
enum ContentStatus {
  draft
  scheduled
  published
  unpublished
  archived

  @@map("content_status")
}

/// Stored media categories (Phase 4, docs/12 §3/§42). External video is NOT a
/// value here: it has no local binary and is modeled as a shared value
/// contract (`ExternalVideo` in `src/shared/media.ts`), not an asset row.
enum MediaType {
  IMAGE
  DOCUMENT

  @@map("media_type")
}

// ---------------------------------------------------------------------------
// Identity & access (foundation only — auth logic is Phase 2).
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                  UserRole[]
  sessions               Session[]
  pagesCreated           Page[]           @relation("PageCreatedBy")
  pagesUpdated           Page[]           @relation("PageUpdatedBy")
  pageRevisionsCreated   PageRevision[]   @relation("PageRevisionCreatedBy")
  sermonsCreated         Sermon[]         @relation("SermonCreatedBy")
  sermonsUpdated         Sermon[]         @relation("SermonUpdatedBy")
  sermonRevisionsCreated SermonRevision[] @relation("SermonRevisionCreatedBy")
  eventsCreated          Event[]          @relation("EventCreatedBy")
  eventsUpdated          Event[]          @relation("EventUpdatedBy")
  ministriesCreated      Ministry[]       @relation("MinistryCreatedBy")
  ministriesUpdated      Ministry[]       @relation("MinistryUpdatedBy")
  mediaAssetsCreated     MediaAsset[]     @relation("MediaAssetCreatedBy")
  auditLogs              AuditLog[]       @relation("AuditLogActor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

/// Join table for the User <-> Role many-to-many relation.
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Join table for the Role <-> Permission many-to-many relation.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A user session. Append-only: revocation is recorded via `revokedAt`, so no
/// `updatedAt` (deliberate exception to the all-tables convention).
///
/// Session lifetime is two-dimensional (docs/11 §6.3):
///   - `expiresAt` is the ABSOLUTE expiry, fixed at creation (`createdAt` +
///     `SESSION_ABSOLUTE_TTL`). It is never extended by activity.
///   - `lastSeenAt` records the last validated request so the auth layer can
///     enforce an IDLE timeout (`lastSeenAt` + `SESSION_IDLE_TTL`); it is the
///     only field mutated after creation (slides forward on each request).
/// `ipAddress`/`userAgent` are optional security metadata captured at login
/// (docs/11 §6.1) for later auditing — they are never returned to clients.
model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  /// SHA-256 of the opaque session token — the lookup key on every request.
  /// Unique so no two sessions can ever share a hash (docs/11 §6.1).
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Editorial content (structural foundation — full domain fields land in
// Phase 3+. Only id/slug/title/status/timestamps + obvious FKs here.)
// ---------------------------------------------------------------------------

model Page {
  id            String        @id @default(uuid())
  slug          String        @unique
  title         String
  /// Short editorial summary used in listings and meta descriptions.
  excerpt       String?
  /// Structured editorial content (known block shape, never an arbitrary
  /// visual page builder — docs/05 §20). Serialized as JSON.
  content       Json?
  coverMediaId  String?       @map("cover_media_id")
  /// Optimistic-concurrency counter (docs/08 §38). A PATCH must present the
  /// version it read; a mismatch is a 409 CONFLICT and a match increments it.
  version       Int           @default(1)
  status        ContentStatus @default(draft)
  publishedAt   DateTime?     @map("published_at")
  /// Future publication instant set by `POST /schedule` (docs/05 §30).
  publishAt     DateTime?     @map("publish_at")
  unpublishedAt DateTime?     @map("unpublished_at")
  createdById   String?       @map("created_by")
  updatedById   String?       @map("updated_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  createdBy User?          @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cover     MediaAsset?    @relation("PageCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  revisions PageRevision[]

  @@index([status, publishedAt])
  @@index([status, publishAt])
  @@index([createdById])
  @@index([coverMediaId])
  @@map("pages")
}

/// Immutable snapshot of a page at a point in time (docs/08 §11.9, §32).
/// Append-only: no `updatedAt`. `snapshot` holds the full editable content
/// (`PageSnapshot` in `@shared/cms`) so a revision is self-contained and can be
/// restored without reconstructing it from the live row.
model PageRevision {
  id          String   @id @default(uuid())
  pageId      String   @map("page_id")
  version     Int
  title       String
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by")

  page      Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PageRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([pageId, version])
  @@index([createdById])
  @@map("page_revisions")
}

model Sermon {
  id                 String        @id @default(uuid())
  slug               String        @unique
  title              String
  description        String?
  scriptureReference String?       @map("scripture_reference")
  scriptureText      String?       @map("scripture_text")
  /// Denormalized display name kept for legacy/imported sermons that have no
  /// `Person` row yet. New sermons should reference `preacherId` (docs/05 §8).
  preacherName       String?       @map("preacher_name")
  sermonDate         DateTime?     @map("sermon_date")
  // --- Sermon domain (Phase 5A, docs/05 §8–10). External video/audio are
  //     references only; binaries never live in PostgreSQL (docs/12 §38). ---
  preacherId         String?       @map("preacher_id")
  seriesId           String?       @map("series_id")
  coverMediaId       String?       @map("cover_media_id")
  videoProvider      String?       @map("video_provider")
  videoExternalId    String?       @map("video_external_id")
  videoUrl           String?       @map("video_url")
  audioUrl           String?       @map("audio_url")
  notesMediaId       String?       @map("notes_media_id")
  notesContent       String?       @map("notes_content")
  durationMinutes    Int?          @map("duration_minutes")
  featured           Boolean       @default(false)
  status             ContentStatus @default(draft)
  /// Optimistic-concurrency counter (docs/08 §38). A PATCH must present the
  /// version it read; a mismatch is a 409 CONFLICT and a match increments it.
  version            Int           @default(1)
  publishedAt        DateTime?     @map("published_at")
  /// Future publication instant set by `POST /schedule` (docs/05 §30). Paired
  /// with `status = scheduled`; `publishDueSermons()` promotes due rows.
  publishAt          DateTime?     @map("publish_at")
  unpublishedAt      DateTime?     @map("unpublished_at")
  createdById        String?       @map("created_by")
  updatedById        String?       @map("updated_by")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  createdBy User?            @relation("SermonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("SermonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  preacher  Person?          @relation(fields: [preacherId], references: [id], onDelete: SetNull)
  series    SermonSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  cover     MediaAsset?      @relation("SermonCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  notes     MediaAsset?      @relation("SermonNotes", fields: [notesMediaId], references: [id], onDelete: SetNull)
  topics    SermonTopic[]
  revisions SermonRevision[]

  @@index([status, publishedAt])
  @@index([status, publishAt])
  @@index([createdById])
  @@index([preacherId])
  @@index([seriesId])
  @@index([coverMediaId])
  @@index([notesMediaId])
  @@index([featured, publishedAt])
  @@map("sermons")
}

/// A person referenced by content (sermon preacher today; reusable later).
/// Deleting the photo asset only clears the reference — the person survives
/// (SetNull), and the person itself is never deleted by a sermon edit.
model Person {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  displayName  String   @map("display_name")
  role         String?
  photoMediaId String?  @map("photo_media_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  photo   MediaAsset? @relation("PersonPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  sermons Sermon[]

  @@index([active, displayName])
  @@index([photoMediaId])
  @@map("people")
}

/// A series groups related sermons (docs/05 §9). Deleting a series never
/// deletes its sermons: the FK is SetNull, so they simply become standalone.
model SermonSeries {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  coverMediaId String?   @map("cover_media_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cover   MediaAsset? @relation("SeriesCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  sermons Sermon[]

  @@index([coverMediaId])
  @@map("sermon_series")
}

/// Cross-cutting classification for sermons (docs/05 §10).
model Topic {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sermons SermonTopic[]

  @@map("topics")
}

/// Join table for Sermon <-> Topic (many-to-many, docs/05 §10).
model SermonTopic {
  sermonId String @map("sermon_id")
  topicId  String @map("topic_id")

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([sermonId, topicId])
  @@index([topicId])
  @@map("sermon_topics")
}

/// Immutable snapshot of a sermon at a point in time (docs/08 §11.9, §32).
/// Append-only: no `updatedAt`. `snapshot` holds the full editorial content
/// (`SermonSnapshot` in `@shared/cms`) so a revision is self-contained and can
/// be restored without reconstructing it from the live row.
model SermonRevision {
  id          String   @id @default(uuid())
  sermonId    String   @map("sermon_id")
  version     Int
  title       String
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by")

  sermon    Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("SermonRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sermonId, version])
  @@index([createdById])
  @@map("sermon_revisions")
}

/// Editorial category for events (docs/05 §12). Declared before `Event` so the
/// relation reads top-down. Deleting a category never deletes its events: the
/// FK is SetNull, so they simply become uncategorized.
model EventCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("event_categories")
}

/// Event domain (Phase 6A, docs/05 §11–12). Location is intentionally stored as
/// flat text (`locationName`/`address`/`city`) instead of a `Location` model —
/// docs/05 §11 describes a future Location relation, but Phase 6A only needs
/// displayable text (documented decision in `odd/tasks/phase6-events-ministries.md`).
model Event {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  summary         String?
  description     String?
  categoryId      String?       @map("category_id")
  startAt         DateTime?     @map("start_at")
  endAt           DateTime?     @map("end_at")
  locationName    String?       @map("location_name")
  address         String?
  city            String?
  coverMediaId    String?       @map("cover_media_id")
  registrationUrl String?       @map("registration_url")
  featured        Boolean       @default(false)
  status          ContentStatus @default(draft)
  /// Optimistic-concurrency counter (docs/08 §38). A PATCH must present the
  /// version it read; a mismatch is a 409 CONFLICT and a match increments it.
  version         Int           @default(1)
  publishedAt     DateTime?     @map("published_at")
  /// Future publication instant set by `POST /schedule` (docs/05 §30). Paired
  /// with `status = scheduled`.
  publishAt       DateTime?     @map("publish_at")
  unpublishedAt   DateTime?     @map("unpublished_at")
  createdById     String?       @map("created_by")
  updatedById     String?       @map("updated_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  createdBy User?          @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  category  EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cover     MediaAsset?    @relation("EventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([status, publishAt])
  @@index([startAt])
  @@index([categoryId])
  @@index([coverMediaId])
  @@index([featured, publishedAt])
  @@map("events")
}

/// Ministry domain (Phase 6A, docs/05 §13). Leaders/locations are not modeled
/// yet; Phase 6A only exposes the content fields, cover and contact/CTA data.
model Ministry {
  id               String        @id @default(uuid())
  slug             String        @unique
  name             String
  shortDescription String?       @map("short_description")
  description      String?
  coverMediaId     String?       @map("cover_media_id")
  contactEmail     String?       @map("contact_email")
  contactPhone     String?       @map("contact_phone")
  meetingInfo      String?       @map("meeting_info")
  ctaLabel         String?       @map("cta_label")
  ctaUrl           String?       @map("cta_url")
  featured         Boolean       @default(false)
  status           ContentStatus @default(draft)
  /// Optimistic-concurrency counter (docs/08 §38).
  version          Int           @default(1)
  publishedAt      DateTime?     @map("published_at")
  /// Future publication instant set by `POST /schedule` (docs/05 §30).
  publishAt        DateTime?     @map("publish_at")
  unpublishedAt    DateTime?     @map("unpublished_at")
  createdById      String?       @map("created_by")
  updatedById      String?       @map("updated_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  createdBy User?       @relation("MinistryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?       @relation("MinistryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cover     MediaAsset? @relation("MinistryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([status, publishAt])
  @@index([coverMediaId])
  @@index([featured, publishedAt])
  @@map("ministries")
}

// ---------------------------------------------------------------------------
// Navigation, media, SEO and system tables.
// ---------------------------------------------------------------------------

/// Self-referencing navigation tree (docs/05 §45, docs/08 §14). `parentId` is
/// null for top-level items; deleting a parent orphans its children (SetNull).
/// `location` scopes the menu (HEADER / FOOTER) and `target` is the optional
/// link target (`_self` / `_blank`).
model Navigation {
  id        String   @id @default(uuid())
  label     String
  href      String
  external  Boolean  @default(false)
  /// Menu this item belongs to, e.g. `HEADER` / `FOOTER`.
  location  String   @default("HEADER")
  /// Optional link target: `_self` / `_blank`.
  target    String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Navigation?  @relation("NavigationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Navigation[] @relation("NavigationTree")

  @@index([parentId])
  @@index([location, order])
  @@map("navigation")
}

/// Slug-change redirect foundation (docs/08 §14, Phase 9 serves it). When a
/// published page changes slug, a row records the old slug so the HTTP layer
/// can answer a permanent redirect. `fromPath` is globally unique because a
/// path can only map to one destination.
model Redirect {
  id         String   @id @default(uuid())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("redirects")
}

/// Binary/media asset metadata (Phase 4, docs/12 §9–11, docs/08 §15).
///
/// The binary is never stored here. `storageKey` is the stable reference used
/// by every provider; `url` is a cached public URL and is re-derived from the
/// storage adapter when a DTO is served, so replacing the provider never
/// changes the domain model (docs/12 §5–6). The original user filename is
/// metadata only — the storage key is always app-generated (docs/12 §22).
model MediaAsset {
  id          String    @id @default(uuid())
  type        MediaType @default(IMAGE)
  filename    String
  mimeType    String    @map("mime_type")
  size        Int
  /// Stable provider-independent storage reference (`{folder}/{YYYY}/{MM}/{uuid}.{ext}`).
  storageKey  String    @unique @map("storage_key")
  /// Storage provider that owns the binary, e.g. `filesystem`.
  provider    String    @default("filesystem")
  /// Cached public URL; authoritative URL is derived from `storageKey`.
  url         String
  altText     String?   @map("alt_text")
  title       String?
  description String?
  caption     String?
  folder      String?
  width       Int?
  height      Int?
  createdById String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy      User?            @relation("MediaAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  references     MediaReference[]
  variants       MediaVariant[]
  // Content relations (Phase 5A). SetNull on the asset means deleting a media
  // asset never deletes content; the reference-aware delete in Phase 4 still
  // blocks it while a `MediaReference` row exists.
  sermonCovers   Sermon[]         @relation("SermonCover")
  sermonNotes    Sermon[]         @relation("SermonNotes")
  seriesCovers   SermonSeries[]   @relation("SeriesCover")
  personPhotos   Person[]         @relation("PersonPhoto")
  eventCovers    Event[]          @relation("EventCover")
  ministryCovers Ministry[]       @relation("MinistryCover")
  pageCovers     Page[]           @relation("PageCover")

  @@index([createdById])
  @@index([type, createdAt])
  @@index([folder])
  @@map("media_assets")
}

/// Generated image derivative (docs/12 §27–28). Variants are owned by their
/// parent asset and disappear with it; they are immutable after creation
/// (hence no `updatedAt`). The storage key is app-generated, never derived
/// from a user filename.
model MediaVariant {
  id           String   @id @default(uuid())
  mediaAssetId String   @map("media_asset_id")
  /// Stable derivative label: `thumbnail`, `small`, `medium`.
  label        String
  /// Encoding format; currently `webp`.
  format       String
  storageKey   String   @unique @map("storage_key")
  /// Cached public URL; authoritative URL is derived from `storageKey`.
  url          String
  width        Int?
  height       Int?
  size         Int?
  createdAt    DateTime @default(now()) @map("created_at")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, label])
  @@index([mediaAssetId])
  @@map("media_variants")
}

/// Polymorphic join between content and media assets. `onDelete: Restrict`
/// enforces "a referenced asset cannot be deleted" (docs/08 §37).
model MediaReference {
  id           String   @id @default(uuid())
  mediaAssetId String   @map("media_asset_id")
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  purpose      String?
  createdAt    DateTime @default(now()) @map("created_at")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([mediaAssetId])
  @@index([entityType, entityId])
  @@map("media_references")
}

/// One SEO record per content entity (docs/05 §26, docs/10 §12.1).
model SeoMetadata {
  id           String   @id @default(uuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  title        String?
  description  String?
  canonicalUrl String?  @map("canonical_url")
  ogImageUrl   String?  @map("og_image_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId])
  @@map("seo_metadata")
}

/// Key/value site configuration (docs/05 §24). Values are structured JSON.
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Inbound contact-form submission. Append-only in practice but keeps
/// `updatedAt` for uniform tooling.
model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("contact_submissions")
}

/// Immutable audit trail (docs/08 §21, docs/11). Append-only: no `updatedAt`,
/// rows are never mutated after creation.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
