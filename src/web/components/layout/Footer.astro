---
/**
 * Footer — dark, compact closing surface (docs/03 §24, docs/04 §18).
 *
 * The approved mockup uses a single navigation row (logo, links, socials) and
 * a quiet practical line (address / schedule / contact / copyright) instead of
 * the previous five-column layout. All data comes from the repository layer.
 */
import { Mail, MessageCircle, Phone } from '@lucide/astro';
import { Image } from 'astro:assets';
import logoFull from '../../assets/brand/uci-logo-full.png';
import {
  getChurchProfile,
  getNavigation,
  getServiceSchedules,
} from '../../data/site';
import Container from '../ui/Container.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import type {
  ChurchProfile,
  ServiceSchedule,
  SiteNavigation,
} from '@shared/types';

interface Props {
  /** Page-resolved identity (SSR). Falls back to settings/public. */
  church?: ChurchProfile;
  /** Page-resolved CMS navigation. Falls back to the API. */
  navigation?: SiteNavigation;
  /** Active recurring schedules. Falls back to settings/public. */
  schedules?: ServiceSchedule[];
}

const church = Astro.props.church ?? (await getChurchProfile());
const navigation = Astro.props.navigation ?? (await getNavigation());
const schedules = Astro.props.schedules ?? (await getServiceSchedules());

const DAY_NAMES = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
const formatSchedule = (schedule: (typeof schedules)[number]) =>
  `${DAY_NAMES[schedule.dayOfWeek]} ${schedule.startTime}`;

const year = new Date().getFullYear();

// Honest degradation (docs/04 §6.6, §24): settings may leave contact, socials
// and the address unfilled. Never fall back to fictitious values — hide the
// block or show a "por confirmar" state instead.
const locationCityLine = [church.location.city, church.location.state]
  .filter(Boolean)
  .join(', ');
const whatsappHref = church.whatsapp
  ? `https://wa.me/${church.whatsapp.replace(/[^\d]/g, '')}`
  : null;
const hasContact = Boolean(church.phone || church.email || whatsappHref);
---

<footer class="footer">
  <Container wide>
    <div class="footer__inner">
      <div class="footer__top">
        <a class="footer__brand" href="/" aria-label={`${church.name} — Inicio`}>
          <Image
            class="footer__logo"
            src={logoFull}
            alt={church.fullName}
            width={260}
            height={98}
            widths={[180, 260]}
            sizes="130px"
            loading="eager"
            decoding="async"
          />
        </a>

        <nav class="footer__nav" aria-label="Navegación del pie de página">
          <ul class="footer__links">
            {
              navigation.footer.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        {
          church.socialLinks.length > 0 && (
            <ul class="footer__social" aria-label="Redes sociales">
              {church.socialLinks.map((social) => (
                <li>
                  <a
                    href={social.url}
                    rel="noopener noreferrer"
                    target="_blank"
                    aria-label={social.label}
                  >
                    <SocialIcon name={social.platform} size={18} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="footer__meta">
        <div class="footer__details">
          <address class="footer__address">
            {church.location.name && <span>{church.location.name}</span>}
            <span>{church.location.address || 'Dirección por confirmar'}</span>
            {locationCityLine && <span>{locationCityLine}</span>}
          </address>

          {
            schedules.length > 0 ? (
              <ul class="footer__schedule">
                {schedules.map((schedule) => (
                  <li>{formatSchedule(schedule)}</li>
                ))}
              </ul>
            ) : (
              <p class="footer__muted">Horarios por confirmar.</p>
            )
          }

          {
            hasContact ? (
              <ul class="footer__contact">
                {church.phone && (
                  <li>
                    <a href={`tel:${church.phone.replace(/\s+/g, '')}`}>
                      <Phone size={14} stroke-width={1.75} />
                      {church.phone}
                    </a>
                  </li>
                )}
                {church.email && (
                  <li>
                    <a href={`mailto:${church.email}`}>
                      <Mail size={14} stroke-width={1.75} />
                      {church.email}
                    </a>
                  </li>
                )}
                {whatsappHref && (
                  <li>
                    <a
                      href={whatsappHref}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <MessageCircle size={14} stroke-width={1.75} />
                      WhatsApp
                    </a>
                  </li>
                )}
              </ul>
            ) : (
              <p class="footer__muted">Contacto por confirmar.</p>
            )
          }
        </div>

        <p class="footer__copyright">
          © {year} {church.fullName}.
        </p>
      </div>
    </div>
  </Container>
</footer>

<style>
  .footer {
    position: relative;
    background-color: var(--color-black);
    border-top: 1px solid var(--border-on-dark);
    padding-block: var(--section-padding-y-sm);
    color: var(--color-white);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-32);
    flex-wrap: wrap;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .footer__logo {
    height: 2.5rem;
    width: auto;
    filter: var(--brand-logo-filter);
  }

  .footer__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-8) var(--space-24);
  }

  .footer__links a {
    color: var(--color-gray-light);
    font-size: var(--font-size-body-small);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__links a:hover {
    color: var(--color-gold);
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }

  .footer__social a {
    color: var(--color-gray-light);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__social a:hover {
    color: var(--color-gold);
  }

  .footer__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-24);
    flex-wrap: wrap;
    padding-top: var(--space-24);
    border-top: 1px solid var(--border-on-dark);
  }

  .footer__details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-24);
    color: var(--color-gray);
    font-size: var(--font-size-caption);
  }

  .footer__address {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    font-style: normal;
  }

  .footer__schedule {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-16);
  }

  .footer__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-16);
  }

  .footer__contact a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-gray-light);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__contact a:hover {
    color: var(--color-gold);
  }

  .footer__muted {
    color: var(--color-gray);
  }

  .footer__copyright {
    color: var(--color-gray);
    font-size: var(--font-size-caption);
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .footer__top {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__nav {
      justify-content: flex-start;
    }

    .footer__links {
      justify-content: flex-start;
    }
  }

  @media (max-width: 639px) {
    .footer__links {
      gap: var(--space-4) var(--space-16);
    }

    .footer__meta {
      flex-direction: column;
    }
  }
</style>
