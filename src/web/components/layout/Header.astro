---
/**
 * Header — global navigation.
 *
 * IMPORTANT: this header is designed to sit OVER the hero. It renders as a
 * fixed, transparent layer at the top of the page and transitions to a solid
 * deep-navy surface once the user scrolls (docs/03 §10.2, §10.3, docs/04 §5.3).
 * Any page that uses it without a full-bleed hero must add top padding so its
 * content clears the fixed header.
 *
 * Data comes from the repository layer; the page does not pass navigation props
 * so the header stays consistent across routes.
 *
 * Layout note: the inner grid lives in a native wrapper INSIDE `Container`.
 * Astro scoped styles do not reach a child component root element, so styling
 * `.site-header__inner` on the `Container` itself silently failed (the bar
 * collapsed into a block). The native wrapper keeps the styles local and the
 * grid contract intact.
 */
import { Menu, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import logoFull from '../../assets/brand/uci-logo-full.png';
import { getChurchProfile, getNavigation } from '../../data/site';
import Container from '../ui/Container.astro';
import type { ChurchProfile, SiteNavigation } from '@shared/types';

interface Props {
  /** Page-resolved identity (SSR). Falls back to settings/public. */
  church?: ChurchProfile;
  /** Page-resolved CMS navigation. Falls back to the API. */
  navigation?: SiteNavigation;
}

const navigation = Astro.props.navigation ?? (await getNavigation());
const church = Astro.props.church ?? (await getChurchProfile());

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const primary = navigation.primary;
const [newcomerAction, liveAction] = navigation.actions;
const menuId = 'primary-navigation';
---

<header class="site-header" data-header>
  <Container wide>
    <div class="site-header__inner">
      <a class="site-header__brand" href="/" aria-label={`${church.name} — Inicio`}>
        <Image
          class="site-header__logo"
          src={logoFull}
          alt={church.fullName}
          width={320}
          height={120}
          widths={[160, 240, 320]}
          sizes="160px"
          loading="eager"
          decoding="async"
        />
      </a>

      <nav
        id={menuId}
        class="site-header__nav"
        aria-label="Navegación principal"
        data-nav
      >
        <ul class="site-header__links">
          {
            primary.map((item) => (
              <li>
                <a
                  class:list={[
                    'site-header__link',
                    { 'is-active': !item.external && isActive(item.href) },
                  ]}
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="site-header__actions">
          {
            newcomerAction && (
              <a class="site-header__cta site-header__cta--ghost" href={newcomerAction.href}>
                {newcomerAction.label}
              </a>
            )
          }
          {
            liveAction && (
              <a class="site-header__cta site-header__cta--gold" href={liveAction.href}>
                {liveAction.label}
              </a>
            )
          }
        </div>
      </nav>

      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls={menuId}
        data-menu-toggle
      >
        <span class="visually-hidden">Abrir menú de navegación</span>
        <span class="site-header__toggle-icon site-header__toggle-icon--menu">
          <Menu size={24} />
        </span>
        <span class="site-header__toggle-icon site-header__toggle-icon--close">
          <X size={24} />
        </span>
      </button>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      backdrop-filter var(--duration-base) var(--ease-out);
  }

  /* Solid state applied by the scroll script.
     NOTE: `backdrop-filter` makes the header a containing block for fixed
     descendants. The mobile menu is a fixed full-screen panel inside this
     header, so it must not inherit a backdrop filter: otherwise `inset: 0`
     resolves against the 84px header instead of the viewport. */
  .site-header.is-scrolled:not(.is-menu-open) {
    background-color: rgba(8, 14, 26, 0.94);
    border-bottom-color: var(--border-on-dark);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-header.is-menu-open {
    background-color: rgba(8, 14, 26, 0.94);
    border-bottom-color: var(--border-on-dark);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-16);
    min-height: 5.25rem;
    padding-block: var(--space-12);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    flex-shrink: 0;
  }

  .site-header__logo {
    height: var(--brand-logo-height);
    width: auto;
    filter: var(--brand-logo-filter);
  }

  .site-header__nav {
    display: contents;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    justify-self: center;
    gap: clamp(0.75rem, 0.2rem + 1vw, 1.75rem);
  }

  .site-header__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-8);
    color: var(--color-white);
    font-size: var(--font-size-navigation);
    letter-spacing: var(--letter-spacing-nav);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .site-header__link:hover {
    color: var(--color-gold-light);
  }

  .site-header__link.is-active {
    color: var(--color-gold);
  }

  .site-header__link.is-active::after,
  .site-header__link:hover::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-12);
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: 0.6875rem var(--space-24);
    border-radius: var(--radius-md);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-nav);
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  /* “Soy nuevo”: translucent dark pill, the quieter action. */
  .site-header__cta--ghost {
    background-color: rgba(5, 7, 10, 0.35);
    color: var(--color-white);
    border: 1px solid rgba(255, 255, 255, 0.28);
  }

  .site-header__cta--ghost:hover {
    background-color: rgba(5, 7, 10, 0.6);
    border-color: rgba(255, 255, 255, 0.55);
  }

  /* “Ver en vivo”: gold, the primary action. */
  .site-header__cta--gold {
    background-color: var(--color-gold);
    color: var(--color-black);
    border: 1px solid var(--color-gold);
  }

  .site-header__cta--gold:hover {
    background-color: var(--color-gold-light);
    border-color: var(--color-gold-light);
  }

  /* --- Mobile toggle ---------------------------------------------------- */
  .site-header__toggle {
    display: none;
    position: relative;
    align-items: center;
    justify-content: center;
    justify-self: end;
    width: 2.75rem;
    height: 2.75rem;
    padding: var(--space-8);
    border-radius: var(--radius-md);
    color: var(--color-white);
  }

  .site-header__toggle-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .site-header__toggle-icon--close {
    opacity: 0;
    transform: rotate(-45deg);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon--menu {
    opacity: 0;
    transform: rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon--close {
    opacity: 1;
    transform: rotate(0);
  }

  /* --- Mobile ----------------------------------------------------------- */
  @media (max-width: 1023px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      min-height: 4.75rem;
    }

    .site-header__toggle {
      display: flex;
    }

    .site-header__nav {
      position: fixed;
      inset: 0;
      z-index: var(--z-mobile-menu);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: var(--space-32);
      padding: 6.5rem var(--container-padding-inline) var(--space-40);
      background-color: var(--color-black);
      overflow-y: auto;
      transform: translateY(-100%);
      visibility: hidden;
      transition:
        transform var(--duration-base) var(--ease-out),
        visibility var(--duration-base) var(--ease-out);
    }

    .site-header__nav.is-open {
      transform: translateY(0);
      visibility: visible;
    }

    .site-header__links {
      flex-direction: column;
      align-items: stretch;
      justify-self: stretch;
      gap: var(--space-4);
    }

    .site-header__link {
      display: block;
      padding: var(--space-16) 0;
      font-size: var(--font-size-body-large);
    }

    .site-header__link::after {
      display: none;
    }

    .site-header__actions {
      flex-direction: column;
      align-items: stretch;
      justify-self: stretch;
      gap: var(--space-12);
    }

    .site-header__cta {
      justify-content: center;
      padding: var(--space-16);
      font-size: var(--font-size-body);
    }

    /* Keep the toggle above the opened panel. */
    .site-header__toggle {
      position: relative;
      z-index: calc(var(--z-mobile-menu) + 1);
    }

    .site-header__logo {
      height: 2.5rem;
    }
  }

  @media (max-width: 479px) {
    .site-header__logo {
      height: 2.25rem;
    }
  }
</style>

<script is:inline nonce={Astro.locals.cspNonce}>
  // Minimal, dependency-free header behavior:
  // 1. Toggle the solid surface after a small scroll threshold.
  // 2. Accessible mobile menu (aria-expanded, Escape, focus management).
  //
  // Kept as an inline script (with the CSP nonce) because Astro inlines
  // hoisted scripts in SSR mode; a bundled external file would be blocked by
  // the strict `script-src` policy (Phase 12A).
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-nav]');

  if (header && toggle && nav) {
    let ticking = false;

    const applyScrollState = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(applyScrollState);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    applyScrollState();

    const setMenu = (open) => {
      nav.classList.toggle('is-open', open);
      header.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        nav.querySelector('a')?.focus();
      } else {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) setMenu(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
      }
    });

    // Reset the mobile state when crossing into the desktop layout.
    const desktop = window.matchMedia('(min-width: 1024px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches && toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
      }
    });
  }
</script>
