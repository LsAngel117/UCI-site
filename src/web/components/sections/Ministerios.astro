---
/**
 * Ministerios — "Encuentra tu lugar" (docs/04 §14, docs/03 §20).
 *
 * The approved mockup turns this into a dark photographic invitation card that
 * sits beside the upcoming-events list, so the component renders only the card
 * and the homepage owns the mosaic row (see `pages/index.astro`).
 *
 * The card is deliberately an invitation rather than a directory grid: the
 * full ministry listing lives at `/ministerios`.
 */
import { Image } from 'astro:assets';
import fallbackImage from '../../assets/home/hero-worship.png';
import { getMinisteriosContent } from '../../data/site';
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';

const section = getMinisteriosContent();
---

<aside class="ministerios" aria-labelledby="ministerios-heading">
  <div class="ministerios__media" aria-hidden="true">
    <Image
      class="ministerios__image"
      src={fallbackImage}
      alt=""
      aria-hidden="true"
      width={2307}
      height={794}
      widths={[720, 1200, 1600]}
      sizes="(min-width: 1024px) 30vw, 90vw"
      loading="lazy"
      decoding="async"
    />
    <div class="ministerios__overlay"></div>
  </div>

  <div class="ministerios__content">
    <SectionLabel>{section.label}</SectionLabel>
    <h2 id="ministerios-heading" class="ministerios__heading font-display">
      {section.heading}
    </h2>
    <p class="ministerios__support">{section.supportingText}</p>
    <div class="ministerios__action">
      <Button href={section.cta.href} variant="secondary" arrow>
        {section.cta.label}
      </Button>
    </div>
  </div>
</aside>

<style>
  .ministerios {
    position: relative;
    display: flex;
    overflow: hidden;
    height: 100%;
    min-height: 22rem;
    border-radius: var(--radius-md);
    background-color: var(--color-navy);
    isolation: isolate;
  }

  .ministerios__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .ministerios__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ministerios__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(5, 7, 10, 0.95) 0%,
        rgba(5, 7, 10, 0.55) 55%,
        rgba(5, 7, 10, 0.25) 100%
      ),
      linear-gradient(120deg, rgba(11, 18, 32, 0.75) 0%, rgba(11, 18, 32, 0.15) 80%);
  }

  .ministerios__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: var(--space-16);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .ministerios__heading {
    font-size: var(--font-size-heading-2);
    font-weight: var(--font-weight-medium);
    color: var(--color-white);
    text-transform: uppercase;
    letter-spacing: 0.005em;
    max-width: 12ch;
  }

  .ministerios__support {
    color: var(--color-gray-light);
    font-size: var(--font-size-body-small);
    max-width: 30ch;
  }

  .ministerios__action {
    margin-top: var(--space-8);
  }

  @media (max-width: 1023px) {
    .ministerios {
      min-height: 18rem;
    }
  }
</style>
