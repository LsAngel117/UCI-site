---
/**
 * Somos UCI — identity section after the hero (docs/04 §7).
 *
 * Dark navy surface, editorial two-column composition. The brand visual is
 * integrated into the background with an atmospheric blue glow rather than
 * placed inside a generic card (docs/04 §7.4).
 *
 * The approved mockup keeps this section to the identity mark alone (globe +
 * Bible + heartbeat); the wide congregational photograph is used instead by
 * the first-visit section, where the mockup places community photography.
 *
 * Layout note: the two-column grid lives in a native wrapper inside
 * `Container`, because Astro scoped styles do not reach a child component
 * root element.
 */
import { Image } from 'astro:assets';
import brandVisual from '../../assets/brand/uci-globe-bible-heartbeat.png';
import { getAboutSection } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionLabel from '../ui/SectionLabel.astro';

const about = getAboutSection();
---

<Section id="somos-uci" surface="navy" spacing="lg" class="somos">
  <div class="somos__glow" aria-hidden="true"></div>

  <Container>
    <div class="somos__inner">
      <div class="somos__content">
        <SectionLabel>{about.label}</SectionLabel>
        <h2 class="somos__heading font-display">{about.heading}</h2>
        <p class="somos__body text-body-large">{about.body}</p>
        <div class="somos__cta">
          <Button href={about.cta.href} variant="secondary" arrow>
            {about.cta.label}
          </Button>
        </div>
      </div>

      <div class="somos__visual" aria-hidden="true">
        <div class="somos__orbit"></div>
        <Image
          class="somos__visual-image"
          src={brandVisual}
          alt=""
          aria-hidden="true"
          width={900}
          height={900}
          widths={[420, 640, 900]}
          sizes="(min-width: 1024px) 44vw, 80vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </Container>
</Section>

<style>
  :global(.somos) {
    overflow: hidden;
    /* Deep navy -> black, keeping the identity surface cinematic. */
    background: var(--gradient-dark);
  }

  .somos__glow {
    position: absolute;
    inset: -20% -10% auto 35%;
    height: 120%;
    background: var(--gradient-blue-glow);
    opacity: 0.7;
    pointer-events: none;
  }

  .somos__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(3rem, 1rem + 6vw, 6rem);
  }

  .somos__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
    max-width: 36rem;
  }

  .somos__heading {
    font-size: var(--font-size-heading-1);
    font-weight: var(--font-weight-medium);
    color: var(--color-white);
    max-width: 18ch;
  }

  .somos__body {
    color: var(--color-gray-light);
    max-width: 46ch;
  }

  .somos__cta {
    margin-top: var(--space-8);
  }

  /* --- Integrated visual ------------------------------------------------ */
  .somos__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Faint concentric orbit behind the mark, echoing its own gold orbit. */
  .somos__orbit {
    position: absolute;
    width: 96%;
    aspect-ratio: 1;
    border: 1px solid rgba(91, 184, 245, 0.18);
    border-radius: 50%;
    transform: rotate(-18deg) scaleY(0.62);
    pointer-events: none;
  }

  .somos__visual-image {
    position: relative;
    width: min(100%, 36rem);
    height: auto;
    /* The asset is a transparent PNG; no background box by design. */
    filter: drop-shadow(0 24px 60px rgba(5, 7, 10, 0.55));
  }

  @media (max-width: 1023px) {
    .somos__inner {
      grid-template-columns: 1fr;
      gap: var(--space-40);
    }

    .somos__visual-image {
      width: min(100%, 20rem);
    }

    .somos__orbit {
      width: 82%;
    }
  }
</style>
