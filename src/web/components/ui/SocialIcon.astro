  },
};

const glyph = BRAND_PATHS[name];
---

{
  glyph ? (
    <svg
      class:list={['social-icon', className]}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      role="img"
      aria-hidden="true"
      focusable="false"
    >
      <path d={glyph.d} fill-rule={glyph.fillRule} />
    </svg>
  ) : (
    <ExternalLink size={size} class={className} stroke-width={1.75} />
  )
}

<style>
  .social-icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
