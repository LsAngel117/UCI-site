---
/**
 * SocialIcon — filled brand/social marks that Lucide no longer ships.
 *
 * Lucide removed its brand set (trademark), so the four social glyphs the site
 * actually uses (youtube, instagram, facebook, whatsapp) stay as local inline
 * SVGs (docs/02 §5.1). Every other icon in the public site comes from
 * `@lucide/astro`.
 *
 * Unknown platforms fall back to Lucide's `ExternalLink` so a social link never
 * renders without an icon (same behavior the old `isIconName` fallback had).
 */
import { ExternalLink } from '@lucide/astro';

interface Props {
  /** Brand key: youtube | instagram | facebook | whatsapp. */
  name: string;
  /** Rendered size in px (square). */
  size?: number;
  /** Extra classes from the consuming layout. */
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

// Filled 24×24 glyphs (fill=currentColor), preserved from the original
// hand-authored set for visual continuity.
