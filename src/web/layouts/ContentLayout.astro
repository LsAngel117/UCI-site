---
/**
 * ContentLayout — shared chrome for the public content routes (Phase 9B1).
 *
 * Wraps `BaseLayout` with the CMS-driven header/footer so archive and detail
 * pages only compose their own content. Pages that also need the church
 * identity for page-level SEO pass the already-resolved values; otherwise the
 * layout loads them once per request.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getChurchProfile, getNavigation } from '../data/site';
import type { ChurchProfile, SiteNavigation } from '@shared/types';
import type { JsonLdObject } from '@shared/seo';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImageUrl?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: JsonLdObject[];
  church?: ChurchProfile;
  navigation?: SiteNavigation;
}

const {
  title,
  description,
  canonicalPath,
  ogImageUrl,
  ogType,
  noindex,
  jsonLd,
  church: providedChurch,
  navigation: providedNavigation,
} = Astro.props;

const church = providedChurch ?? (await getChurchProfile());
const navigation = providedNavigation ?? (await getNavigation());
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImageUrl={ogImageUrl}
  ogType={ogType}
  noindex={noindex}
  jsonLd={jsonLd}
  church={church}
>
  <Header slot="header" church={church} navigation={navigation} />
  <slot />
  <Footer slot="footer" church={church} navigation={navigation} />
</BaseLayout>
