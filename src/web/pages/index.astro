---
/**
 * Homepage — full composition.
 *
 * Sections follow the approved order in docs/04 §4 and the composite layout of
 * the approved mockup: the three pillars and the practical service panel share
 * one light row, and the events/ministries and stories/generosity pairs share
 * a light mosaic before the final invitation.
 *
 * The previous implementation styled layout classes on the root element of
 * `Container`/`Section`. Astro scoped styles do not reach a child component
 * root, so those rules silently failed and sections stacked. This file keeps
 * every layout wrapper as a native element inside the component to keep the
 * scoped contract honest.
 *
 * All content is read through the repository layer (`src/data/site.ts`); no
 * production data is hardcoded here.
 */
import { ArrowRight, Calendar, MapPin } from '@lucide/astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SomosUCI from '../components/sections/SomosUCI.astro';
import ThreePillars from '../components/sections/ThreePillars.astro';
import ProximoServicio from '../components/sections/ProximoServicio.astro';
import PrimeraVez from '../components/sections/PrimeraVez.astro';
import UltimoSermon from '../components/sections/UltimoSermon.astro';
import ExploraMensajes from '../components/sections/ExploraMensajes.astro';
import ProximosEventos from '../components/sections/ProximosEventos.astro';
import Ministerios from '../components/sections/Ministerios.astro';
import Historias from '../components/sections/Historias.astro';
import Generosidad from '../components/sections/Generosidad.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import MediaPlaceholder from '../components/ui/MediaPlaceholder.astro';
import Section from '../components/ui/Section.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import { isLocalAsset, isRemoteAsset } from '../components/ui/media-source';
import { getHomeData } from '../data/site';
import { formatServiceDay, formatTime12h } from '../lib/format';

// SSR request-time data. One parallel round of API calls powers every dynamic
// section; if the API is down the getters degrade to honest empty states.
const home = await getHomeData();
const { church, hero, nextService } = home;

// W1: no invented 'Domingo'/'09:00' fallbacks. When there is no scheduled
// service, the strip shows an honest "por confirmar" state (docs/04 §6.6).
const serviceDay = nextService
  ? formatServiceDay(nextService.schedule.dayOfWeek) ?? 'PRÓXIMO SERVICIO'
  : 'PRÓXIMO SERVICIO';
const serviceTime = nextService
  ? formatTime12h(nextService.schedule.startTime) ?? 'Por confirmar'
  : 'Por confirmar';
const stripLocation = nextService?.location ?? church.location;
const servicePlace =
  [stripLocation.city, stripLocation.state].filter(Boolean).join(', ') ||
  'Ubicación por confirmar';
const serviceAddress = stripLocation.address || 'Dirección por confirmar';
const hasRoute = church.location.confirmed && Boolean(church.location.mapUrl);

const pageTitle = `${church.fullName} | Una iglesia que intercede`;
const pageDescription = church.shortDescription;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  church={church}
>
  <Header slot="header" church={church} navigation={home.navigation} />

  {/* =====================================================================
      HERO (docs/04 §6)
      Real approved worship photography with a cinematic dark overlay that
      keeps the image recognizable while guaranteeing text contrast.
      ===================================================================== */}
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__media" aria-hidden="true">
      {
        isLocalAsset(hero.backgroundImageUrl) ? (
          <Image
            class="hero__image"
            src={hero.backgroundImageUrl}
            alt=""
            aria-hidden="true"
            width={2307}
            height={794}
            widths={[720, 1200, 1600, 2307]}
            sizes="100vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : isRemoteAsset(hero.backgroundImageUrl) ? (
          <img
            class="hero__image"
            src={hero.backgroundImageUrl}
            alt=""
            aria-hidden="true"
            decoding="async"
          />
        ) : (
          <MediaPlaceholder
            class="hero__image"
            label="Adoración en UCI"
            aspect="2307 / 794"
            asset="hero-worship.jpg"
          />
        )
      }
      <div class="hero__overlay"></div>
      <div class="hero__vignette"></div>
    </div>

    <div class="hero__stage">
      <Container>
        <div class="hero__content">
          <SectionLabel accent="gold">{hero.label}</SectionLabel>

          <h1 id="hero-heading" class="hero__heading font-display">
            {hero.headingLineOne}
            <span class="hero__heading-accent">{hero.headingAccent}</span>
          </h1>

          <p class="hero__supporting text-body-large">{hero.supportingText}</p>

          <div class="hero__actions">
            <Button href={hero.primaryCta.href} variant="primary" arrow>
              {hero.primaryCta.label}
            </Button>
            <Button
              href={hero.secondaryCta.href}
              variant="secondary"
              icon="play"
            >
              {hero.secondaryCta.label}
            </Button>
          </div>
        </div>
      </Container>
    </div>

    {/* Practical service strip (docs/04 §6.6). */}
    <div class="hero__strip">
      <Container>
        <div class="hero__strip-inner">
          <div class="hero__strip-item">
            <span class="hero__strip-icon" aria-hidden="true">
              <Calendar size={18} stroke-width={1.75} />
            </span>
            <span class="hero__strip-copy">
              <span class="hero__strip-label">{serviceDay}</span>
              <span class="hero__strip-value">{serviceTime}</span>
            </span>
          </div>

          <div class="hero__strip-item">
            <span class="hero__strip-icon" aria-hidden="true">
              <MapPin size={18} stroke-width={1.75} />
            </span>
            <span class="hero__strip-copy">
              <span class="hero__strip-label">Ubicación</span>
              <span class="hero__strip-value">{serviceAddress}</span>
              <span class="hero__strip-sub">{servicePlace}</span>
            </span>
          </div>

          {
            hasRoute ? (
              <a
                class="hero__strip-route"
                href={church.location.mapUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                CÓMO LLEGAR
                <ArrowRight size={16} stroke-width={1.75} />
              </a>
            ) : (
              <span class="hero__strip-route hero__strip-route--muted">
                Ruta por confirmar
              </span>
            )
          }
        </div>
      </Container>
    </div>
  </section>

  <SomosUCI />

  {/* En UCI + Nos vemos este domingo — one light composite row (mockup). */}
  <Section id="en-uci" surface="light" spacing="lg" class="invitacion">
    <Container>
      <div class="invitacion__grid">
        <ThreePillars />
        <ProximoServicio church={church} nextService={nextService} />
      </div>
    </Container>
  </Section>

  <PrimeraVez />
  <UltimoSermon sermon={home.featuredSermon} />
  <ExploraMensajes sermons={home.recentSermons} />

  {/* Community mosaic: events + ministries, stories + generosity (mockup). */}
  <Section id="comunidad" surface="light" spacing="lg" class="mosaico">
    <Container>
      <div class="mosaico__rows">
        <div class="mosaico__row mosaico__row--top">
          <ProximosEventos events={home.upcomingEvents} />
          <Ministerios />
        </div>
        <div class="mosaico__row mosaico__row--bottom">
          <Historias story={home.featuredStory} />
          <Generosidad giving={home.giving} />
        </div>
      </div>
    </Container>
  </Section>

  <FinalCTA />

  <Footer
    slot="footer"
    church={church}
    navigation={home.navigation}
    schedules={home.schedules}
  />
</BaseLayout>

<style>
  /* =====================================================================
     Hero
     ===================================================================== */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background-color: var(--color-black);
    color: var(--color-white);
    overflow: hidden;
    isolation: isolate;
  }

  /* --- Media layer ------------------------------------------------------ */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero-overlay);
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 28% 68%,
        rgba(22, 117, 209, 0.26) 0%,
        rgba(5, 7, 10, 0) 58%
      ),
      linear-gradient(to top, rgba(5, 7, 10, 0.85) 0%, rgba(5, 7, 10, 0) 38%);
  }

  .hero__stage {
    flex: 1;
    display: grid;
    align-content: end;
    padding-block: 8rem clamp(3rem, 6vh, 4.5rem);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-24);
    max-width: 46rem;
  }

  .hero__heading {
    font-size: var(--font-size-display-xl);
    font-weight: var(--font-weight-medium);
    color: var(--color-white);
  }

  .hero__heading-accent {
    display: block;
    color: var(--color-gold);
  }

  .hero__supporting {
    max-width: 44ch;
    color: var(--color-gray-light);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    margin-top: var(--space-8);
  }

  /* --- Service strip ---------------------------------------------------- */
  .hero__strip {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    background-color: rgba(5, 7, 10, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero__strip-inner {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 0.5rem + 3vw, 3.5rem);
    padding-block: var(--space-16);
  }

  .hero__strip-item {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .hero__strip-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border-on-dark);
    border-radius: 50%;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .hero__strip-copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .hero__strip-label {
    color: var(--color-gray);
    font-size: var(--font-size-caption);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .hero__strip-value {
    color: var(--color-white);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
  }

  .hero__strip-sub {
    color: var(--color-gray-light);
    font-size: var(--font-size-body-small);
  }

  .hero__strip-route {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    margin-left: auto;
    padding: 0.6875rem var(--space-24);
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: var(--radius-md);
    color: var(--color-white);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .hero__strip-route:hover {
    background-color: rgba(91, 184, 245, 0.14);
    border-color: var(--color-blue-light);
  }

  .hero__strip-route--muted {
    border-color: transparent;
    color: var(--color-gray);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--letter-spacing-normal);
    text-transform: none;
  }

  /* =====================================================================
     Composite rows
     ===================================================================== */
  .invitacion__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  /* =====================================================================
     Mosaic
     ===================================================================== */
  .mosaico__rows {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .mosaico__row {
    display: grid;
    gap: var(--space-24);
    align-items: stretch;
  }

  .mosaico__row--top {
    grid-template-columns: minmax(0, 2.05fr) minmax(0, 1fr);
  }

  .mosaico__row--bottom {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  }

  @media (max-width: 1023px) {
    .invitacion__grid {
      grid-template-columns: 1fr;
    }

    .mosaico__row--top,
    .mosaico__row--bottom {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 92svh;
    }

    .hero__stage {
      padding-block: 7rem var(--space-32);
    }

    .hero__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .hero__strip-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-16);
      padding-block: var(--space-24);
    }

    .hero__strip-route {
      margin-left: 0;
    }
  }

  @media (max-width: 479px) {
    /* Keep “QUE INTERCEDE.” on a single line at phone widths. */
    .hero__heading {
      font-size: 2.125rem;
    }
  }
</style>
