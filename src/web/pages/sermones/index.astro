---
/**
 * /sermones — sermon archive (mockup-approved composition).
 *
 * Sections:
 * 1. Cinematic hero over the approved worship photograph.
 * 2. Featured latest sermon with the preacher placeholder and pull quotes.
 * 3. Light archive surface: category chips, search, sort and sermon cards.
 * 4. Featured series band.
 * 5. Final invitation over the supplied Bible/globe background.
 *
 * The hero reuses the approved worship image because it is the same photograph
 * shown in the mockup. The preacher portrait, card covers and series image are
 * intentionally styled placeholders until the real assets are added. Product
 * copy is transcribed verbatim from the approved mockup.
 */
import {
  ArrowRight,
  BookOpen,
  CalendarDays,
  ChevronDown,
  Image as ImageIcon,
  Mic,
  Play,
  Search,
  UserRound,
} from '@lucide/astro';
import { Image } from 'astro:assets';
import { getChurchProfile, getNavigation } from '../../data/site';
import { buildStaticPageJsonLd } from '../../lib/seo';
import ContentLayout from '../../layouts/ContentLayout.astro';
import Button from '../../components/ui/Button.astro';
import Container from '../../components/ui/Container.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';

import heroImage from '../../assets/home/hero-worship.png';
import ctaImage from '../../assets/sermones/la-palabra-sigue-fondo.webp';

const [church, navigation] = await Promise.all([
  getChurchProfile(),
  getNavigation(),
]);

const title = 'Sermones | Iglesia UCI';
const description =
  'Escucha la Palabra y vive la Palabra. En cada mensaje encontramos dirección, esperanza y una invitación a crecer en Cristo.';
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;
const jsonLd = buildStaticPageJsonLd({
  name: 'Sermones',
  description,
  path: '/sermones',
  siteUrl,
});

const latestSermon = {
  title: 'De la sombra a la gloria',
  slug: 'de-la-sombra-a-la-gloria',
  scripture: 'Juan 11:4',
  preacher: 'Juan',
  date: '31 AGO 2026',
  description:
    'Un mensaje poderoso sobre la esperanza de Cristo, que nos llama a salir de la oscuridad y caminar en Su luz.',
};

const sermons = [
  {
    title: 'De la sombra a la gloria',
    slug: 'de-la-sombra-a-la-gloria',
    scripture: 'Juan 11:4',
    preacher: 'Juan',
    date: '31 AGO 2026',
    dateIso: '2026-08-31',
  },
  {
    title: 'La fe que vence',
    slug: 'la-fe-que-vence',
    scripture: 'Marcos 5:36',
    preacher: 'Juan',
    date: '24 AGO 2026',
    dateIso: '2026-08-24',
  },
  {
    title: 'El propósito de Dios',
    slug: 'el-proposito-de-dios',
    scripture: 'Jeremías 29:11',
    preacher: 'Ana Torres',
    date: '17 AGO 2026',
    dateIso: '2026-08-17',
  },
  {
    title: 'No te rindas',
    slug: 'no-te-rindas',
    scripture: 'Gálatas 6:9',
    preacher: 'Juan',
    date: '10 AGO 2026',
    dateIso: '2026-08-10',
  },
  {
    title: 'Cuando avanzar exige soltar',
    slug: 'cuando-avanzar-exige-soltar',
    scripture: '2 Reyes 3:16-20',
    preacher: 'Carlos Méndez',
    date: '03 AGO 2026',
    dateIso: '2026-08-03',
  },
  {
    title: 'Una vida de oración',
    slug: 'una-vida-de-oracion',
    scripture: '1 Tesalonicenses 5:17',
    preacher: 'Ana Torres',
    date: '27 JUL 2026',
    dateIso: '2026-07-27',
  },
];
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath="/sermones"
  jsonLd={jsonLd}
  church={church}
  navigation={navigation}
>
  <div class="sermones">
    {/* =================================================================
        Hero
        ================================================================= */}
    <section class="hero" aria-labelledby="sermones-hero-title">
      <div class="hero__media" aria-hidden="true">
        <Image
          class="hero__image"
          src={heroImage}
          alt=""
          width={2307}
          height={794}
          widths={[768, 1280, 1920, 2307]}
          sizes="100vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero__scrim"></div>
        <div class="hero__glow"></div>
      </div>

      <Container>
        <div class="hero__content">
          <SectionLabel accent="gold" withRule>
            Mensajes que edifican y transforman
          </SectionLabel>

          <h1 id="sermones-hero-title" class="hero__title font-display">
            <!--<span class="hero__title-line">Escucha la Palabra.</span>-->{' '}
            <span class="hero__title-accent">Hacedores de la Palabra.</span>
          </h1>

          <p class="hero__support">
            En cada mensaje encontramos dirección, esperanza y una invitación a
            crecer en Cristo.
          </p>

          <a class="hero__link" href="#explora">
            Explora nuestros mensajes
            <ArrowRight size={17} stroke-width={1.75} />
          </a>
        </div>
      </Container>
    </section>

    {/* =================================================================
        Latest sermon
        ================================================================= */}
    <section class="ultimo" aria-labelledby="ultimo-title">
      <div class="ultimo__glow" aria-hidden="true"></div>

      <Container>
        <div class="ultimo__grid">
          <div class="ultimo__copy">
            <SectionLabel accent="gold" withRule>Último sermón</SectionLabel>

            <h2 id="ultimo-title" class="ultimo__title font-display">
              <span>De la sombra</span>{' '}
              <span class="ultimo__title-accent">A la gloria</span>
            </h2>

            <p class="ultimo__scripture">
              <BookOpen size={17} stroke-width={1.6} aria-hidden="true" />
              {latestSermon.scripture}
            </p>

            <p class="ultimo__text">{latestSermon.description}</p>

            <div class="ultimo__meta">
              <span>
                <UserRound size={16} stroke-width={1.6} aria-hidden="true" />
                {latestSermon.preacher}
              </span>
              <span class="ultimo__divider" aria-hidden="true"></span>
              <span>
                <CalendarDays size={16} stroke-width={1.6} aria-hidden="true" />
                {latestSermon.date}
              </span>
            </div>

            <div class="ultimo__actions">
              <Button
                href={`/sermones/${latestSermon.slug}`}
                variant="primary"
                icon="play"
              >
                Ver sermón
              </Button>
              <Button
                href={`/sermones/${latestSermon.slug}#notas`}
                variant="secondary"
                icon="file"
              >
                Ver notas
              </Button>
            </div>
          </div>

          <div class="ultimo__media">
            <div class="ultimo__portrait" aria-hidden="true">
              <span class="ultimo__portrait-halo"></span>
              <UserRound
                class="ultimo__portrait-icon"
                size={132}
                stroke-width={0.7}
              />
              <Mic
                class="ultimo__portrait-mic"
                size={38}
                stroke-width={1.2}
              />
              <span class="ultimo__pending">Imagen pendiente</span>
            </div>

            <blockquote class="ultimo__quote ultimo__quote--top">
              <span>Su presencia</span>
              <span>vale más que</span>
              <span>cualquier tradición.</span>
            </blockquote>

            <svg
              class="ultimo__arrow ultimo__arrow--top"
              viewBox="0 0 132 76"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M124 14C94 8 58 12 23 40"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
              <path
                d="M23 40L34 24M23 40L42 44"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>

            <blockquote class="ultimo__quote ultimo__quote--bottom">
              <span>La puedes</span>
              <span>no anunciar tu final.</span>
            </blockquote>

            <svg
              class="ultimo__arrow ultimo__arrow--bottom"
              viewBox="0 0 132 76"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M8 58C32 24 68 8 116 22"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
              <path
                d="M116 22L103 18M116 22L109 35"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
          </div>
        </div>
      </Container>
    </section>

    {/* =================================================================
        Archive
        ================================================================= */}
    <section id="explora" class="explora" aria-labelledby="explora-title">
      <Container>
        <div class="explora__head">
          <h2 id="explora-title" class="explora__title font-display">
            <span class="explora__rule" aria-hidden="true"></span>
            Explora nuestros mensajes
          </h2>
          <p class="explora__intro">
            Encuentra inspiración, aprende y crece en la Palabra de Dios.
          </p>
        </div>

        <div class="explora__toolbar">
          <div class="explora__tabs" aria-label="Categorías de sermones">
            <span class="explora__tab is-active">Todos</span>
            <span class="explora__tab">Predicadores</span>
            <span class="explora__tab">Series</span>
            <span class="explora__tab">Temas</span>
          </div>

          <div class="explora__controls">
            <div class="explora__search">
              <Search size={17} stroke-width={1.7} aria-hidden="true" />
              <label class="visually-hidden" for="sermon-search">
                Buscar un mensaje
              </label>
              <input
                id="sermon-search"
                type="search"
                placeholder="Buscar un mensaje..."
                autocomplete="off"
                data-sermon-search
              />
            </div>

            <div class="explora__sort">
              <label class="visually-hidden" for="sermon-sort">
                Ordenar sermones
              </label>
              <select id="sermon-sort" data-sermon-sort>
                <option value="recent">Más recientes</option>
                <option value="oldest">Más antiguos</option>
              </select>
              <ChevronDown size={16} stroke-width={1.7} aria-hidden="true" />
            </div>

            <details class="explora__dates" data-date-filter>
              <summary class="explora__date-toggle">
                <CalendarDays size={16} stroke-width={1.6} aria-hidden="true" />
                <span data-date-label>Filtrar por fechas</span>
              </summary>

              <div class="explora__date-panel">
                <div class="explora__date-fields">
                  <label class="explora__date-field" for="sermon-from">
                    <span>Desde</span>
                    <input
                      id="sermon-from"
                      type="date"
                      data-sermon-from
                    />
                  </label>
                  <label class="explora__date-field" for="sermon-to">
                    <span>Hasta</span>
                    <input id="sermon-to" type="date" data-sermon-to />
                  </label>
                </div>

                <div class="explora__date-actions">
                  <button
                    type="button"
                    class="explora__date-apply"
                    data-date-apply
                  >
                    Aplicar
                  </button>
                  <button
                    type="button"
                    class="explora__date-clear"
                    data-date-clear
                  >
                    Limpiar
                  </button>
                </div>
              </div>
            </details>

          </div>
        </div>

        <ul class="sermon-grid" data-sermon-grid>
          {
            sermons.map((sermon, index) => (
              <li
                class="sermon-card"
                data-sermon
                data-search={`${sermon.title} ${sermon.scripture} ${sermon.preacher}`.toLowerCase()}
                data-date={sermon.dateIso}
              >
                <a
                  class="sermon-card__link"
                  href={`/sermones/${sermon.slug}`}
                >
                  <div class={`sermon-card__media sermon-card__media--${index + 1}`}>
                    <span class="sermon-card__pending" aria-hidden="true">
                      <ImageIcon size={22} stroke-width={1.4} />
                      <span>Imagen pendiente</span>
                    </span>
                    <span class="sermon-card__play" aria-hidden="true">
                      <Play size={17} stroke-width={1.8} fill="currentColor" />
                    </span>
                  </div>

                  <div class="sermon-card__body">
                    <h3 class="sermon-card__title">{sermon.title}</h3>
                    <div class="sermon-card__meta">
                      <span class="sermon-card__scripture">
                        {sermon.scripture}
                      </span>
                      <span class="sermon-card__separator" aria-hidden="true">
                        |
                      </span>
                      <span class="sermon-card__preacher">
                        {sermon.preacher}
                      </span>
                      <span class="sermon-card__date">
                        <CalendarDays
                          size={13}
                          stroke-width={1.6}
                          aria-hidden="true"
                        />
                        {sermon.date}
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="sermon-empty" data-sermon-empty hidden>
          No encontramos mensajes con esos filtros.
        </p>

        <nav class="pagination" aria-label="Paginación de sermones">
          <span class="pagination__page is-active" aria-current="page">1</span>
          <span class="pagination__page">2</span>
          <span class="pagination__page">3</span>
          <span class="pagination__ellipsis" aria-hidden="true">...</span>
          <span class="pagination__next">
            Siguiente
            <ArrowRight size={15} stroke-width={1.7} aria-hidden="true" />
          </span>
        </nav>
      </Container>
    </section>

    {/* =================================================================
        Featured series
        ================================================================= */}
    <section class="serie" aria-labelledby="serie-title">
      <div class="serie__media" aria-hidden="true">
        <div class="serie__glow"></div>
        <div class="serie__grain"></div>
        <span class="serie__pending">
          <ImageIcon size={18} stroke-width={1.4} />
          Imagen pendiente
        </span>
      </div>

      <Container>
        <div class="serie__content">
          <SectionLabel accent="gold" withRule>Serie destacada:</SectionLabel>
          <h2 id="serie-title" class="serie__title font-display">
            Caminando en fe
          </h2>
          <p class="serie__text">
            Una serie para fortalecer tu fe y seguir a Cristo.
          </p>
        </div>
      </Container>
    </section>

    {/* =================================================================
        Final invitation
        ================================================================= */}
    <section class="cierre" aria-labelledby="sermones-cierre-title">
      <div class="cierre__media" aria-hidden="true">
        <Image
          class="cierre__image"
          src={ctaImage}
          alt=""
          width={1672}
          height={734}
          widths={[768, 1280, 1672]}
          sizes="100vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
        <div class="cierre__scrim"></div>
      </div>

      <Container>
        <div class="cierre__content">
          <h2 id="sermones-cierre-title" class="cierre__title font-display">
            La palabra de Dios sigue hablando
          </h2>
          <p class="cierre__text">
            Ven y descubre un mensaje que transformará tu vida.
          </p>
          <div class="cierre__action">
            <Button href="/soy-nuevo" variant="primary" arrow>
              Planea tu visita
            </Button>
          </div>
        </div>
      </Container>
    </section>
  </div>
</ContentLayout>

<script>
  const grid = document.querySelector<HTMLUListElement>('[data-sermon-grid]');
  const search = document.querySelector<HTMLInputElement>(
    '[data-sermon-search]',
  );
  const sort = document.querySelector<HTMLSelectElement>('[data-sermon-sort]');
  const dateFilter = document.querySelector<HTMLDetailsElement>(
    '[data-date-filter]',
  );
  const dateToggle = document.querySelector<HTMLElement>(
    '.explora__date-toggle',
  );
  const dateLabel = document.querySelector<HTMLElement>('[data-date-label]');
  const from = document.querySelector<HTMLInputElement>('[data-sermon-from]');
  const to = document.querySelector<HTMLInputElement>('[data-sermon-to]');
  const applyDates = document.querySelector<HTMLButtonElement>(
    '[data-date-apply]',
  );
  const clearDates = document.querySelector<HTMLButtonElement>(
    '[data-date-clear]',
  );
  const empty = document.querySelector<HTMLParagraphElement>(
    '[data-sermon-empty]',
  );

  if (grid && search && sort && from && to) {
    const cards = [...grid.querySelectorAll<HTMLLIElement>('[data-sermon]')];

    const apply = () => {
      const query = search.value.trim().toLowerCase();
      const fromValue = from.value;
      const toValue = to.value;
      let visible = 0;

      for (const card of cards) {
        const date = card.dataset.date ?? '';
        const matchesQuery =
          query.length === 0 ||
          (card.dataset.search ?? '').includes(query);
        const matchesDate =
          (!fromValue || date >= fromValue) &&
          (!toValue || date <= toValue);
        const matches = matchesQuery && matchesDate;
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      const ordered = [...cards].sort((a, b) => {
        const aDate = a.dataset.date ?? '';
        const bDate = b.dataset.date ?? '';
        return sort.value === 'oldest'
          ? aDate.localeCompare(bDate)
          : bDate.localeCompare(aDate);
      });

      for (const card of ordered) grid.append(card);

      if (empty) empty.hidden = visible > 0;
      dateToggle?.classList.toggle(
        'is-active',
        Boolean(fromValue || toValue),
      );

      if (dateLabel) {
        const months = [
          'ENE',
          'FEB',
          'MAR',
          'ABR',
          'MAY',
          'JUN',
          'JUL',
          'AGO',
          'SEP',
          'OCT',
          'NOV',
          'DIC',
        ];
        const format = (value: string) => {
          if (!value) return '';
          const [, month, day] = value.split('-');
          return `${day} ${months[Number(month) - 1]}`;
        };

        if (fromValue && toValue) {
          dateLabel.textContent = `${format(fromValue)} – ${format(toValue)}`;
        } else if (fromValue) {
          dateLabel.textContent = `Desde ${format(fromValue)}`;
        } else if (toValue) {
          dateLabel.textContent = `Hasta ${format(toValue)}`;
        } else {
          dateLabel.textContent = 'Filtrar por fechas';
        }
      }
    };

    search.addEventListener('input', apply);
    sort.addEventListener('change', apply);
    from.addEventListener('change', apply);
    to.addEventListener('change', apply);

    applyDates?.addEventListener('click', () => {
      apply();
      if (dateFilter) dateFilter.open = false;
    });

    clearDates?.addEventListener('click', () => {
      from.value = '';
      to.value = '';
      apply();
    });

    apply();
  }
</script>

<style>
  .sermones {
    --sermons-ink: #0b2a4a;
    --sermons-blue: #1d5b96;
    --sermons-soft: #4c6784;
    background-color: var(--color-black);
  }

  #explora {
    scroll-margin-top: 6rem;
  }

  /* =====================================================================
     Hero
     ===================================================================== */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(24rem, 28vw, 29rem);
    padding-block: 6rem 1.5rem;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        95deg,
        rgba(4, 9, 18, 0.96) 0%,
        rgba(6, 16, 32, 0.78) 45%,
        rgba(6, 16, 32, 0.25) 100%
      ),
      linear-gradient(
        to top,
        rgba(5, 15, 28, 0.98) 0%,
        rgba(5, 15, 28, 0) 48%
      );
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 64% 36%,
      rgba(22, 117, 209, 0.35) 0%,
      rgba(22, 117, 209, 0) 56%
    );
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
    max-width: 50rem;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 3.6rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: var(--letter-spacing-tight);
    text-transform: uppercase;
  }

  .hero__title-line,
  .hero__title-accent {
    display: block;
  }

  .hero__title-accent {
    color: var(--color-gold);
  }

  .hero__support {
    max-width: 34rem;
    margin: 0;
    color: var(--color-gray-light);
    font-size: var(--font-size-body-large);
    line-height: var(--line-height-body);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-gold);
    color: var(--color-white);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-semibold);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .hero__link :global(svg) {
    color: var(--color-gold);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .hero__link:hover {
    color: var(--color-gold-light);
    border-color: var(--color-gold-light);
  }

  .hero__link:hover :global(svg) {
    transform: translateX(3px);
  }

  /* =====================================================================
     Latest sermon
     ===================================================================== */
  .ultimo {
    position: relative;
    padding-block: clamp(2.5rem, 3.5vw, 3.5rem);
    overflow: hidden;
    isolation: isolate;
    background-color: #07182b;
    color: var(--color-white);
  }

  .ultimo__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 82% 36%,
        rgba(22, 117, 209, 0.18) 0%,
        rgba(22, 117, 209, 0) 44%
      ),
      linear-gradient(
        90deg,
        rgba(5, 15, 28, 0.56) 0%,
        rgba(5, 15, 28, 0) 55%
      );
    pointer-events: none;
  }

  .ultimo__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .ultimo__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
    max-width: 35rem;
  }

  .ultimo__title {
    margin: 0;
    font-size: clamp(1.95rem, 1.4rem + 1.6vw, 2.85rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.05;
    letter-spacing: var(--letter-spacing-tight);
    text-transform: uppercase;
  }

  .ultimo__title span {
    display: block;
  }

  .ultimo__title-accent {
    color: var(--color-gold);
  }

  .ultimo__scripture {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    margin: 0;
    color: var(--color-gold);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-medium);
  }

  .ultimo__text {
    max-width: 30rem;
    margin: 0;
    color: var(--color-gray-light);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  .ultimo__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
    color: var(--color-gray-light);
    font-size: var(--font-size-body-small);
  }

  .ultimo__meta > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
  }

  .ultimo__divider {
    width: 1px;
    height: 1rem;
    background-color: var(--border-on-dark);
  }

  .ultimo__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    margin-top: var(--space-8);
  }

  .ultimo__media {
    position: relative;
    min-height: clamp(17rem, 23vw, 21rem);
  }

  .ultimo__portrait {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    right: 4%;
    width: 62%;
    overflow: hidden;
    background: radial-gradient(
      circle at 50% 38%,
      rgba(91, 184, 245, 0.16) 0%,
      rgba(91, 184, 245, 0) 62%
    );
    color: rgba(255, 255, 255, 0.22);
  }

  .ultimo__portrait-halo {
    position: absolute;
    width: 15rem;
    height: 15rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(91, 184, 245, 0.18) 0%,
      rgba(91, 184, 245, 0) 68%
    );
  }

  .ultimo__portrait-icon {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    opacity: 0.42;
  }

  .ultimo__portrait-mic {
    position: absolute;
    left: 2rem;
    bottom: 2.4rem;
    z-index: 1;
    color: rgba(240, 201, 106, 0.65);
  }

  .ultimo__pending {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 1;
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.625rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .ultimo__quote {
    position: absolute;
    z-index: 2;
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.55vw, 1.3rem);
    font-style: italic;
    line-height: 1.18;
    text-shadow: 0 2px 18px rgba(5, 7, 10, 0.5);
  }

  .ultimo__quote span {
    display: block;
  }

  .ultimo__quote--top {
    left: 0;
    top: 2.75rem;
    max-width: 12rem;
    transform: rotate(-5deg);
  }

  .ultimo__quote--bottom {
    left: 1.5rem;
    bottom: 2.4rem;
    max-width: 12.5rem;
    transform: rotate(-4deg);
  }

  .ultimo__arrow {
    position: absolute;
    z-index: 1;
    color: rgba(255, 255, 255, 0.72);
  }

  .ultimo__arrow--top {
    left: 9.5rem;
    top: 2.4rem;
    width: 8rem;
  }

  .ultimo__arrow--bottom {
    left: 12.5rem;
    bottom: 2rem;
    width: 8rem;
  }

  /* =====================================================================
     Archive
     ===================================================================== */
  .explora {
    padding-block: clamp(3.5rem, 5vw, 5rem);
    background-color: #f3f5f8;
    color: var(--sermons-ink);
  }

  .explora__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .explora__title {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    margin: 0;
    font-size: clamp(1.55rem, 1.2rem + 1.4vw, 2.1rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.01em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .explora__rule {
    display: inline-block;
    width: 2rem;
    height: 1px;
    flex-shrink: 0;
    background-color: var(--color-gold);
    opacity: 1;
  }

  .explora__intro {
    margin: 0;
    max-width: 40rem;
    color: var(--sermons-ink);
    opacity: 0.92;
    font-size: var(--font-size-body);
  }

  .explora__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
    margin-top: var(--space-24);
  }

  .explora__tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }

  .explora__tab {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid rgba(11, 18, 32, 0.16);
    border-radius: var(--radius-pill);
    color: var(--sermons-ink);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .explora__tab.is-active {
    background-color: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-black);
    font-weight: var(--font-weight-semibold);
  }

  .explora__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
  }

  .explora__search,
  .explora__sort {
    position: relative;
    display: flex;
    align-items: center;
    height: 2.5rem;
    border: 1px solid rgba(11, 18, 32, 0.16);
    border-radius: var(--radius-md);
    background-color: var(--color-white-pure);
  }

  .explora__search {
    width: min(14.5rem, 38vw);
    gap: var(--space-8);
    padding-inline: var(--space-12);
    color: var(--color-navy);
  }

  .explora__search:focus-within,
  .explora__sort:focus-within {
    border-color: var(--color-blue);
    box-shadow: 0 0 0 3px rgba(22, 117, 209, 0.15);
  }

  .explora__search :global(svg) {
    flex-shrink: 0;
    opacity: 0.55;
  }

  .explora__search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--sermons-ink);
    font-size: var(--font-size-body-small);
  }

  .explora__search input::placeholder {
    color: var(--sermons-soft);
    opacity: 0.78;
  }

  .explora__sort {
    width: 10.5rem;
  }

  .explora__sort select {
    width: 100%;
    height: 100%;
    padding: 0 2rem 0 var(--space-12);
    border: 0;
    outline: 0;
    appearance: none;
    background: transparent;
    color: var(--sermons-ink);
    font-size: var(--font-size-body-small);
    cursor: pointer;
  }

  .explora__sort :global(svg) {
    position: absolute;
    right: 0.75rem;
    pointer-events: none;
    opacity: 0.55;
  }

  .explora__dates {
    position: relative;
  }

  .explora__date-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 2.5rem;
    padding-inline: var(--space-12);
    border: 1px solid rgba(11, 18, 32, 0.16);
    border-radius: var(--radius-md);
    background-color: var(--color-white-pure);
    color: var(--color-navy);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }

  .explora__date-toggle::-webkit-details-marker {
    display: none;
  }

  .explora__date-toggle::marker {
    content: '';
  }

  .explora__date-toggle:hover {
    border-color: rgba(11, 18, 32, 0.28);
  }

  .explora__date-toggle:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-blue);
    outline-offset: var(--focus-ring-offset);
  }

  .explora__dates[open] .explora__date-toggle {
    border-color: var(--color-blue);
  }

  .explora__date-toggle :global(svg) {
    flex-shrink: 0;
    opacity: 0.6;
  }

  .explora__date-toggle.is-active {
    border-color: var(--color-gold-ink);
    color: var(--color-gold-ink);
  }

  .explora__date-toggle.is-active :global(svg) {
    opacity: 1;
  }

  .explora__date-panel {
    position: absolute;
    top: calc(100% + var(--space-8));
    right: 0;
    z-index: 20;
    width: 21rem;
    padding: var(--space-16);
    border: 1px solid rgba(11, 18, 32, 0.12);
    border-radius: var(--radius-md);
    background-color: var(--color-white-pure);
    box-shadow: var(--shadow-md);
  }

  .explora__date-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
  }

  .explora__date-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-navy);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .explora__date-field input {
    width: 100%;
    height: 2.25rem;
    padding-inline: var(--space-8);
    border: 1px solid rgba(11, 18, 32, 0.16);
    border-radius: var(--radius-sm);
    background-color: var(--color-white-pure);
    color: var(--color-navy);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0;
  }

  .explora__date-field input:focus-visible {
    outline: none;
    border-color: var(--color-blue);
    box-shadow: 0 0 0 3px rgba(22, 117, 209, 0.15);
  }

  .explora__date-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-12);
    margin-top: var(--space-12);
  }

  .explora__date-apply {
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-sm);
    background-color: var(--color-gold);
    color: var(--color-black);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .explora__date-apply:hover {
    background-color: var(--color-gold-light);
    border-color: var(--color-gold-light);
  }

  .explora__date-clear {
    padding: var(--space-4) 0;
    color: var(--color-navy);
    opacity: 0.62;
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    cursor: pointer;
  }

  .explora__date-clear:hover {
    opacity: 1;
  }

  .sermon-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: var(--space-24);
  }

  .sermon-card {
    min-width: 0;
  }

  .sermon-card[hidden] {
    display: none;
  }

  .sermon-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(11, 18, 32, 0.1);
    border-radius: var(--radius-md);
    background-color: var(--color-white-pure);
    box-shadow: 0 1px 2px rgba(11, 18, 32, 0.03);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .sermon-card__link:hover {
    border-color: rgba(11, 18, 32, 0.18);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .sermon-card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #0a1b2d;
    color: rgba(255, 255, 255, 0.48);
  }

  .sermon-card__media--1 {
    background:
      radial-gradient(circle at 42% 35%, rgba(240, 201, 106, 0.24), transparent 40%),
      linear-gradient(135deg, #101e2e, #081523);
  }

  .sermon-card__media--2 {
    background:
      radial-gradient(circle at 65% 45%, rgba(91, 184, 245, 0.22), transparent 45%),
      linear-gradient(135deg, #0c1a2c, #06111e);
  }

  .sermon-card__media--3 {
    background:
      radial-gradient(circle at 70% 40%, rgba(240, 201, 106, 0.42), transparent 42%),
      linear-gradient(135deg, #2a1f1b, #100c0d);
  }

  .sermon-card__media--4 {
    background:
      radial-gradient(circle at 40% 45%, rgba(91, 184, 245, 0.18), transparent 48%),
      linear-gradient(135deg, #17202b, #0a1018);
  }

  .sermon-card__media--5 {
    background:
      radial-gradient(circle at 72% 38%, rgba(240, 201, 106, 0.28), transparent 45%),
      linear-gradient(135deg, #13253a, #07111d);
  }

  .sermon-card__media--6 {
    background:
      radial-gradient(circle at 60% 38%, rgba(91, 184, 245, 0.2), transparent 50%),
      linear-gradient(135deg, #1c1b18, #0b0c0e);
  }

  .sermon-card__pending {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.625rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-align: center;
    text-transform: uppercase;
  }

  .sermon-card__play {
    position: absolute;
    left: var(--space-12);
    bottom: var(--space-12);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-pill);
    background-color: rgba(5, 7, 10, 0.66);
    color: var(--color-white);
    backdrop-filter: blur(4px);
  }

  .sermon-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-16) var(--space-16) var(--space-16);
  }

  .sermon-card__title {
    margin: 0;
    color: var(--sermons-ink);
    font-size: 1.05rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
  }

  .sermon-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
    color: var(--sermons-blue);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .sermon-card__scripture {
    color: var(--sermons-blue);
    font-weight: var(--font-weight-medium);
  }

  .sermon-card__separator {
    opacity: 0.45;
  }

  .sermon-card__date {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
    white-space: nowrap;
  }

  .sermon-empty {
    margin: var(--space-32) 0 0;
    color: var(--sermons-ink);
    font-size: var(--font-size-body);
    text-align: center;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
    margin-top: var(--space-32);
    color: var(--sermons-ink);
    font-size: var(--font-size-body-small);
  }

  .pagination__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
  }

  .pagination__page.is-active {
    background-color: var(--color-gold);
    color: var(--color-black);
    font-weight: var(--font-weight-semibold);
  }

  .pagination__ellipsis {
    color: var(--sermons-soft);
  }

  .pagination__next {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: var(--space-8);
    font-weight: var(--font-weight-medium);
  }

  /* =====================================================================
     Featured series
     ===================================================================== */
  .serie {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(14rem, 18vw, 17rem);
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
    overflow: hidden;
    isolation: isolate;
    background-color: #07182b;
    color: var(--color-white);
  }

  .serie__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        circle at 78% 52%,
        rgba(22, 117, 209, 0.4) 0%,
        rgba(22, 117, 209, 0) 40%
      ),
      linear-gradient(110deg, #06101e 0%, #0a2038 54%, #123d66 100%);
  }

  .serie__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 70% 50%,
      rgba(91, 184, 245, 0.22) 0%,
      rgba(91, 184, 245, 0) 50%
    );
    mix-blend-mode: screen;
  }

  .serie__grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.12) 0.6px,
      transparent 0.6px
    );
    background-size: 18px 18px;
    opacity: 0.18;
  }

  .serie__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    max-width: 36rem;
  }

  .serie__title {
    margin: 0;
    color: var(--color-gold);
    font-size: clamp(2rem, 1.45rem + 2vw, 3rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-tight);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .serie__text {
    margin: 0;
    color: var(--color-gray-light);
    font-size: var(--font-size-body);
  }

  .serie__pending {
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.625rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  /* =====================================================================
     Final invitation
     ===================================================================== */
  .cierre {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(20rem, 34vw, 28rem);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .cierre__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cierre__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 56%;
  }

  .cierre__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(5, 10, 20, 0.95) 0%,
      rgba(5, 10, 20, 0.82) 38%,
      rgba(5, 10, 20, 0.34) 68%,
      rgba(5, 10, 20, 0.04) 100%
    );
  }

  .cierre__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
    max-width: 46rem;
  }

  .cierre__title {
    margin: 0;
    max-width: 46rem;
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.08;
    letter-spacing: var(--letter-spacing-tight);
    text-transform: uppercase;
  }

  .cierre__text {
    max-width: 38rem;
    margin: 0;
    color: var(--color-gray-light);
    font-size: var(--font-size-body-large);
    line-height: var(--line-height-body);
  }

  .cierre__action {
    margin-top: var(--space-8);
  }

  /* =====================================================================
     Responsive
     ===================================================================== */
  @media (max-width: 1023px) {
    .ultimo__grid {
      grid-template-columns: 1fr;
    }

    .ultimo__copy {
      max-width: 42rem;
    }

    .ultimo__media {
      min-height: 23rem;
    }

    .ultimo__portrait {
      width: 58%;
    }

    .explora__toolbar {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-16);
    }

    .explora__controls {
      width: 100%;
    }

    .explora__search {
      width: min(22rem, 58vw);
    }

    .sermon-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 30rem;
      padding-block: 8.5rem 3rem;
    }

    .hero__image {
      object-position: 60% 38%;
    }

    .hero__content {
      gap: var(--space-12);
    }

    .hero__title {
      font-size: clamp(2.35rem, 9vw, 3.2rem);
    }

    .hero__link {
      margin-top: var(--space-4);
    }

    .ultimo {
      padding-block: var(--space-40) var(--space-48);
    }

    .ultimo__media {
      min-height: 21rem;
    }

    .ultimo__portrait {
      width: 70%;
    }

    .ultimo__quote--top {
      top: 1rem;
      max-width: 9.5rem;
      font-size: 1rem;
    }

    .ultimo__quote--bottom {
      left: 0;
      bottom: 1.5rem;
      max-width: 9rem;
      font-size: 0.95rem;
    }

    .ultimo__arrow {
      display: none;
    }

    .ultimo__portrait-icon {
